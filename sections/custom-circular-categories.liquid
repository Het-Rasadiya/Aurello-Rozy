        {
          "value": "scroll",
          "label": "Horizontal Scroll/Swipe"
        },
        {
          "value": "grid",
          "label": "Wrap in Grid"
        }
      ]
    },
    {
      "type": "header",
      "content": "Sizing Options"
    },
    {
      "type": "range",
      "id": "circle_size_desktop",
      "label": "Circle Size (Desktop)",
      "min": 60,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle Size (Mobile)",
      "min": 50,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Desktop Gap Between Items",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile Gap Between Items",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Borders & Hover Styles"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border Thickness",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "circle_padding",
      "label": "Gap between image and border",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#f5e6cf"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Border Hover Color",
      "default": "#800020"
    },
    {
      "type": "header",
      "content": "Text Styles"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Text Font Size (Desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Text Font Size (Mobile)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Text Font Weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Normal (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semi-Bold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text Hover Color",
      "default": "#800020"
    },
    {
      "type": "header",
      "content": "Entrance Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Section Entrance Animation",
      "default": "",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "fade-down", "label": "Fade Down" }

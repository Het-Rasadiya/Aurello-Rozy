<!-- sections/custom-circular-categories.liquid -->

{%- liquid
  assign setwidth = section.settings.setwidth
  assign mobile_layout = section.settings.mobile_layout
  assign circle_size_desktop = section.settings.circle_size_desktop
  assign circle_size_mobile = section.settings.circle_size_mobile
  assign border_thickness = section.settings.border_thickness
  assign border_color = section.settings.border_color
  assign border_hover_color = section.settings.border_hover_color
  assign circle_padding = section.settings.circle_padding
  assign text_color = section.settings.text_color
  assign text_hover_color = section.settings.text_hover_color
  assign font_size_desktop = section.settings.font_size_desktop
  assign font_size_mobile = section.settings.font_size_mobile
  assign font_weight = section.settings.font_weight
  assign gap_desktop = section.settings.gap_desktop
  assign gap_mobile = section.settings.gap_mobile
-%}

{%- render 'style-section' -%}

<style>
  .custom-circular-categories-{{ section.id }} {
    width: 100%;
  }

  .circular-categories-list-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ gap_desktop }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .circular-category-item-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: {{ circle_size_desktop }}px;
    flex-shrink: 0;
  }

  .circular-category-link-{{ section.id }} {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    color: {{ text_color }};
    transition: color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .circular-category-image-wrapper-{{ section.id }} {
    position: relative;
    width: {{ circle_size_desktop }}px;
    height: {{ circle_size_desktop }}px;
    border-radius: 50%;
    overflow: hidden;
    border: {{ border_thickness }}px solid {{ border_color }};
    background-color: #ffffff;
    padding: {{ circle_padding }}px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s ease;
    box-sizing: border-box;
  }

  .circular-category-image-wrapper-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 50%;
    transition: transform 0.5s ease;
  }

  .circular-category-image-wrapper-{{ section.id }} svg {
    width: 50%;
    height: 50%;
    fill: #cccccc;
    border-radius: 50%;
    transition: transform 0.5s ease;
  }

  .circular-category-title-{{ section.id }} {
    font-size: {{ font_size_desktop }}px;
    font-weight: {{ font_weight }};
    color: {{ text_color }};
    margin: 0;
    margin-top: 4px;
    line-height: 1.3;
    transition: color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    word-break: break-word;
  }

  /* Hover Animations */
  .circular-category-link-{{ section.id }}:hover {
    color: {{ text_hover_color }};
  }

  .circular-category-link-{{ section.id }}:hover .circular-category-image-wrapper-{{ section.id }} {
    border-color: {{ border_hover_color }};
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .circular-category-link-{{ section.id }}:hover .circular-category-image-wrapper-{{ section.id }} img,
  .circular-category-link-{{ section.id }}:hover .circular-category-image-wrapper-{{ section.id }} svg {
    transform: scale(1.08);
  }

  .circular-category-link-{{ section.id }}:hover .circular-category-title-{{ section.id }} {
    color: {{ text_hover_color }};
  }

  /* Responsive / Mobile Adjustments */
  @media (max-width: 767px) {
    {%- if mobile_layout == 'scroll' -%}
      .circular-categories-list-{{ section.id }} {
        display: flex;
        flex-wrap: nowrap;
        justify-content: flex-start;
        gap: {{ gap_mobile }}px;
        overflow-x: auto;
        padding: 5px 15px 20px 15px;
        margin: 0 -15px;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        scrollbar-width: none; /* Hide scrollbars Firefox */
      }
      .circular-categories-list-{{ section.id }}::-webkit-scrollbar {
        display: none; /* Hide scrollbars Chrome/Safari */
      }
      .circular-category-item-{{ section.id }} {
        scroll-snap-align: center;
      }
    {%- else -%}
      .circular-categories-list-{{ section.id }} {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: {{ gap_mobile }}px;
      }
    {%- endif -%}

    .circular-category-item-{{ section.id }} {
      width: {{ circle_size_mobile }}px;
    }

    .circular-category-image-wrapper-{{ section.id }} {
      width: {{ circle_size_mobile }}px;
      height: {{ circle_size_mobile }}px;
    }

    .circular-category-title-{{ section.id }} {
      font-size: {{ font_size_mobile }}px;
    }
  }
</style>

<div class="customstyle{{ section.id }} custom-circular-categories-{{ section.id }}" 
     data-aos="{{ section.settings.animation }}"
     data-section-id="{{ section.id }}">
  <div class="{{ setwidth }}">
    {%- render 'section-heading' -%}
    
    <div class="section-block">
      <ul class="circular-categories-list-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign featured_collection = collections[block.settings.collection]
            assign item_title = block.settings.title | default: featured_collection.title | default: "Category Title"
            assign item_link = block.settings.link | default: featured_collection.url | default: "#"
            assign item_image = block.settings.image | default: featured_collection.featured_image
          -%}
          <li class="circular-category-item-{{ section.id }}" {{ block.shopify_attributes }}>
            <a href="{{ item_link }}" class="circular-category-link-{{ section.id }}">
              <div class="circular-category-image-wrapper-{{ section.id }}">
                {%- if item_image != blank -%}
                  <img src="{{ item_image | image_url: width: 300, height: 300, crop: 'center' }}"
                       alt="{{ item_title | escape }}"
                       loading="lazy"
                       width="150"
                       height="150">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="circular-category-title-{{ section.id }}">
                {{ item_title }}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Circular Categories",
  "class": "index-section circular-categories-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Width Layout",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Box"
        },
        {
          "value": "container-fluid",

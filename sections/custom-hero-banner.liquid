<!-- sections/custom-hero-banner.liquid -->
{%- liquid
  assign desktop_aspect = 2.63
  for block in section.blocks
    if block.settings.image_desktop != blank
      assign desktop_aspect = block.settings.image_desktop.aspect_ratio
      break
    endif
  endfor

  assign mobile_aspect = 0.612
  assign has_mobile_image = false
  for block in section.blocks
    if block.settings.image_mobile != blank
      assign mobile_aspect = block.settings.image_mobile.aspect_ratio
      assign has_mobile_image = true
      break
    endif
  endfor

  if has_mobile_image == false
    for block in section.blocks
      if block.settings.image_desktop != blank
        assign mobile_aspect = block.settings.image_desktop.aspect_ratio
        break
      endif
    endfor
  endif
-%}

<style>
  #custom-hero-banner-{{ section.id }} .hero-banner-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    {% if section.settings.desktop_height == 'adapt' %}
      aspect-ratio: {{ desktop_aspect }};
      height: auto;
    {% else %}
      height: {{ section.settings.desktop_height }};
    {% endif %}
  }

  @media (max-width: 767px) {
    #custom-hero-banner-{{ section.id }} .hero-banner-slider {
      {% if section.settings.mobile_height == 'adapt' or has_mobile_image %}
        aspect-ratio: {{ mobile_aspect }} !important;
        height: auto !important;
      {% else %}
        height: {{ section.settings.mobile_height }};
      {% endif %}
    }
  }

  #custom-hero-banner-{{ section.id }} .hero-banner__slide {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  #custom-hero-banner-{{ section.id }} .hero-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  #custom-hero-banner-{{ section.id }} .hero-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #custom-hero-banner-{{ section.id }} .hero-banner__link-wrapper {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  /* Slider Navigation Styles */
  #custom-hero-banner-{{ section.id }} .swiper-button-prev,
  #custom-hero-banner-{{ section.id }} .swiper-button-next {
    color: {{ section.settings.arrow_color }};
    background: {{ section.settings.arrow_bg_color }};
    width: 50px;
    height: 50px;
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  #custom-hero-banner-{{ section.id }} .swiper-button-prev::after,
  #custom-hero-banner-{{ section.id }} .swiper-button-next::after {
    font-size: 18px;
    font-weight: bold;
  }

  #custom-hero-banner-{{ section.id }} .swiper-button-prev:hover,
  #custom-hero-banner-{{ section.id }} .swiper-button-next:hover {
    background: {{ section.settings.arrow_bg_color_hover }};
    transform: scale(1.05);
  }

  #custom-hero-banner-{{ section.id }} .swiper-pagination-bullet {
    background: {{ section.settings.dot_color }};
    opacity: 0.4;
    width: 10px;
    height: 10px;
    margin: 0 6px !important;
    transition: all 0.3s ease;
  }

  #custom-hero-banner-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.dot_color_active }};
    opacity: 1;
    transform: scale(1.2);
  }
</style>

<div class="customstyle{{ section.id }} {{ section.settings.setwidthout }}" data-section-id="{{ section.id }}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
  
  {%- if section.blocks.size > 0 -%}
    <hero-banner-slider 
      id="custom-hero-banner-{{ section.id }}"
      data-autoplay="{{ section.settings.autoplay }}" 
      data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}" 
      data-effect="{{ section.settings.effect }}"
      class="d-block"
    >
      <div class="swiper swiper-container hero-banner-slider">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide hero-banner__slide-container" {{ block.shopify_attributes }}>
              
              <div class="hero-banner__slide">
                {%- if block.settings.slide_link != blank -%}
                  <a href="{{ block.settings.slide_link }}" class="hero-banner__link-wrapper">
                {%- endif -%}

                <!-- Background Media -->
                <picture class="hero-banner__media">
                  {%- if block.settings.image_mobile != blank -%}
                    <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
                  {%- endif -%}
                  {%- if block.settings.image_desktop != blank -%}
                    <img src="{{ block.settings.image_desktop | image_url: width: 1920 }}"
                         alt="{{ block.settings.image_desktop.alt | default: shop.name | escape }}"
                         {% if forloop.first %}
                           loading="eager"
                           fetchpriority="high"
                         {% else %}
                           loading="lazy"
                         {% endif %}
                         class="hero-banner__img"
                         style="object-position: {{ block.settings.image_position }};">
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg hero-banner__img' }}
                  {%- endif -%}
                </picture>

                {%- if block.settings.slide_link != blank -%}
                  </a>
                {%- endif -%}
              </div>

            </div>
          {%- endfor -%}
        </div>

        <!-- Slider Pagination Dots -->
        {%- if section.settings.show_dots -%}
          <div class="swiper-pagination"></div>
        {%- endif -%}

        <!-- Slider Navigation Arrows -->
        {%- if section.settings.show_arrows -%}
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        {%- endif -%}
      </div>
    </hero-banner-slider>
  {%- endif -%}
</div>

<script>
  if (!customElements.get('hero-banner-slider')) {
    class HeroBannerSlider extends HTMLElement {
      connectedCallback() {
        if (typeof Swiper !== 'undefined') {
          this.initSlider();
        } else {
          document.addEventListener('DOMContentLoaded', () => {
            this.initSlider();
          });
        }
        
        // Listen to theme customizer block selections
        this.addEventListener('shopify:block:select', (event) => {
          if (!this.swiperInstance) return;
          const slides = Array.from(this.querySelectorAll('.swiper-slide'));
          const index = slides.indexOf(event.target);
          if (index !== -1) {
            this.swiperInstance.slideToLoop(index);
            if (this.swiperInstance.autoplay) {
              this.swiperInstance.autoplay.stop();
            }
          }
        });

        this.addEventListener('shopify:block:deselect', () => {
          if (!this.swiperInstance) return;
          const autoplayAttr = this.getAttribute('data-autoplay') === 'true';
          if (autoplayAttr && this.swiperInstance.autoplay) {
            this.swiperInstance.autoplay.start();
          }
        });
      }

      initSlider() {
        if (this.swiperInstance) {
          this.swiperInstance.destroy(true, true);
        }
        
        const autoplayAttr = this.getAttribute('data-autoplay') === 'true';
        const autoplaySpeed = parseInt(this.getAttribute('data-autoplay-speed')) || 5000;
        const effect = this.getAttribute('data-effect') || 'slide';
        
        const container = this.querySelector('.swiper-container') || this.querySelector('.swiper');
        if (!container) return;

        const options = {
          slidesPerView: 1,
          loop: this.querySelectorAll('.swiper-slide').length > 1,
          effect: effect,
          speed: 800,
          watchSlidesProgress: true,
          grabCursor: true,
          observer: true,
          observeParents: true,
          pagination: {
            el: this.querySelector('.swiper-pagination'),
            clickable: true,
          },
          navigation: {
            nextEl: this.querySelector('.swiper-button-next'),
            prevEl: this.querySelector('.swiper-button-prev'),
          },
        };

        if (autoplayAttr && this.querySelectorAll('.swiper-slide').length > 1) {
          options.autoplay = {
            delay: autoplaySpeed,
            disableOnInteraction: false,
          };
        }

        if (effect === 'fade') {
          options.fadeEffect = {
            crossFade: true
          };
        }

        this.swiperInstance = new Swiper(container, options);
      }

      disconnectedCallback() {
        if (this.swiperInstance) {
          this.swiperInstance.destroy(true, true);
        }
      }
    }
    customElements.define('hero-banner-slider', HeroBannerSlider);
  }
</script>

